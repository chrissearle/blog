{
  "name": "blog",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "// dev": "fixes a Nuxt 4.4.7 regression where the Vite IPC socket path exceeds macOS's 103-char Unix socket limit",
    "dev": "TMPDIR=/tmp nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "typecheck:scripts": "tsc -p scripts",
    "format": "prettier --write --list-different .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3"
  },
  "packageManager": "pnpm@12.16.0",
  "devDependencies": {
    "@iconify-json/heroicons": "1.2.3",
    "@iconify-json/lucide": "1.2.148",
    "@nuxt/content": "3.16.2",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/image": "2.2.0",
    "@nuxt/scripts": "1.3.12",
    "@nuxt/ui": "4.12.0",
    "@nuxtjs/seo": "6.0.1",
    "@prometheus-io/client": "0.16.1",
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.5",
    "astronomy-engine": "2.1.19",
    "debug": "4.4.3",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "luxon": "3.7.2",
    "nuxt": "4.6.3",
    "parse5": "8.0.1",
    "prettier": "3.9.10",
    "rehype-raw": "7.0.0",
    "remark-emoji": "5.0.2",
    "remark-gfm": "4.0.1",
    "remark-mdc": "3.11.1",
    "remark-rehype": "11.1.2",
    "slugify": "1.6.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "ufo": "1.6.4",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "vue-tsc": "3.3.13"
  },
  "lint-staged": {
    "*.{js,mjs,ts,vue}": "pnpm lint:fix",
    "*.{md,json,css,yml,yaml}": "prettier --write --ignore-unknown"
  }
}
