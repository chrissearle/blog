{
  "name": "blog",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "NUXT_PUBLIC_PROMETHEUS_VERBOSE=false nuxt build",
    "// dev": "fixes a Nuxt 4.4.7 regression where the Vite IPC socket path exceeds macOS's 103-char Unix socket limit",
    "dev": "TMPDIR=/tmp nuxt dev",
    "generate": "NUXT_PUBLIC_PROMETHEUS_VERBOSE=false nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "format": "prettier --write --list-different .",
    "prepare": "husky"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3"
  },
  "packageManager": "pnpm@11.20.0",
  "devDependencies": {
    "@artmizu/nuxt-prometheus": "3.0.4",
    "@iconify-json/heroicons": "1.2.3",
    "@iconify-json/lucide": "1.2.122",
    "@nuxt/content": "3.15.2",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/image": "2.1.0",
    "@nuxt/scripts": "1.3.3",
    "@nuxt/ui": "4.10.0",
    "@nuxtjs/seo": "5.3.10",
    "@nuxtjs/sitemap": "8.3.3",
    "@types/luxon": "3.7.3",
    "debug": "4.4.3",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "luxon": "3.7.2",
    "nuxt": "4.5.2",
    "nuxt-gtag": "4.1.0",
    "parse5": "8.0.1",
    "prettier": "3.9.6",
    "rehype-raw": "7.0.0",
    "remark-emoji": "5.0.2",
    "remark-gfm": "4.0.1",
    "remark-mdc": "3.11.1",
    "remark-rehype": "11.1.2",
    "slugify": "1.6.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "ufo": "1.6.4",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vue": "3.5.41",
    "vue-router": "5.2.0",
    "vue-tsc": "3.3.9"
  },
  "lint-staged": {
    "*.{js,ts,vue}": "pnpm lint:fix"
  }
}
