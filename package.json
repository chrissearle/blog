    "prepare": "husky"
  },
  "dependencies": {
    "@artmizu/nuxt-prometheus": "3.0.0",
    "@nuxt/content": "3.12.0",
    "@nuxt/eslint": "1.15.2",
    "@nuxt/image": "2.0.0",
    "@nuxt/scripts": "0.13.2",
    "@nuxt/ui": "4.6.0",
    "@nuxtjs/seo": "4.0.2",
    "@nuxtjs/sitemap": "8.0.1",
    "@unhead/vue": "2.1.12",
    "better-sqlite3": "12.8.0",
    "eslint": "10.1.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "luxon": "3.7.2",
    "nuxt": "4.4.2",
    "nuxt-gtag": "4.1.0",
    "prettier": "3.8.1",
    "slugify": "1.6.8",
    "typescript": "6.0.2",
    "vue": "3.5.31",
    "vue-router": "5.0.4"
