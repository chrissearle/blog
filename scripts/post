#!/usr/bin/env node

import { mkdir, writeFile } from "fs/promises"
import { join, dirname } from "path"
import { fileURLToPath } from "url"

import { DATE_USAGE, parsePostDate, postDate } from "./astro/format.ts"

const __dirname = dirname(fileURLToPath(import.meta.url))

const args = process.argv.slice(2)
const isAstro = args.includes("--astro") || args.includes("-a")

if (isAstro) {
  // Interactive: looks the target up, copies the image in and asks for photo details
  const { main } = await import("./astro/index.ts")
  await main(args.filter((a) => a !== "--astro" && a !== "-a"))
} else {
  await createPost()
}

function usage() {
  console.error("Usage: post <title> [--images] [--date <date>]")
  console.error(
    "       post --astro [target] [--image <file> | --gallery <id|url|search>] [--laminar <file>]... [--date <date>] [--dry-run]",
  )
  console.error("")
  console.error(
    "  target     catalog id, name or Sun/Moon/planet; comma-separate for several",
  )
  console.error(
    "  --laminar  Laminar capture JSON (planetary); repeat for several videos",
  )
  console.error(
    '  --date     YYYY-MM-DD or "YYYY-MM-DD HH:mm", local time (default now)',
  )
  process.exit(1)
}

function parseArgs(argv) {
  const flags = { images: false, date: undefined, words: [] }
  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i]
    const [name, inline] = arg.split(/=(.*)/s)
    if (name === "--images" || name === "-i") flags.images = true
    else if (name === "--date" || name === "-d") {
      const input = inline ?? argv[++i] ?? ""
      flags.date = parsePostDate(input)
      if (!flags.date) {
        console.error(`Not a valid date: "${input}" - ${DATE_USAGE}`)
        process.exit(1)
      }
    } else if (!arg.startsWith("-")) flags.words.push(arg)
  }
  return flags
}

async function createPost() {
  const flags = parseArgs(args)
  const title = flags.words.join(" ")

  if (!title) {
    usage()
  }

  const slug = title
    .toLowerCase()
    .replace(/['’]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "")

  const date = postDate(flags.date)

  const contentDir = join(__dirname, "..", "content", date.path)
  const postFile = join(contentDir, `${slug}.md`)

  const imageLine = flags.images ? `image: /images/posts/${date.path}/\n` : ""
  const content = `---
title: ${title}
date: ${date.frontmatter}
tags:
intro:
${imageLine}---
`

  await mkdir(contentDir, { recursive: true })
  await writeFile(postFile, content)
  console.log(`Created: ${postFile}`)

  if (flags.images) {
    const imageDir = join(
      __dirname,
      "..",
      "public",
      "images",
      "posts",
      date.path,
    )
    await mkdir(imageDir, { recursive: true })
    console.log(`Created: ${imageDir}`)
  }
}
